<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        The backend runs in this process and binds to loopback only, so its traffic never
        leaves the device. Android blocks cleartext by default (API 28+), which includes
        127.0.0.1, so this exemption is required for the UI to reach the local API.

        Scope is deliberately limited to loopback: everything else stays cleartext-blocked.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain>127.0.0.1</domain>
        <domain>localhost</domain>
    </domain-config>
</network-security-config>
